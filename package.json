{
  "name": "campusbid",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "lint": "eslint . && prettier --check .",
    "typecheck": "pnpm build && pnpm --recursive --if-present typecheck",
    "test": "pnpm build && pnpm --recursive --workspace-concurrency=1 --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
