NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/campusbid?replicaSet=rs0
PORT=3000
LOG_LEVEL=info
JWT_SECRET=replace-this-with-at-least-32-random-characters
MAIL_OUTBOX_KEY=replace-this-with-a-separate-32-character-random-key
COOKIE_NAME=campusbid_refresh
# COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
AUCTION_WORKER_MODE=off
